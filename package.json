{
  "name": "chinese-fortune-temple",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "有据山寺：浏览器里运行 chinese-fortune Skill 的 3D 网页山寺",
  "license": "MIT",
  "scripts": {
    "fetch-skill": "node scripts/fetch-skill.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "build": "npm run fetch-skill && npm run copy-pyodide && npm run typecheck && vite build && node scripts/build-sw.mjs",
    "dev": "vite",
    "preview": "vite preview --host 127.0.0.1 --port 4780 --strictPort",
    "test:e2e": "npm run parity-reference && playwright test",
    "copy-pyodide": "node scripts/copy-pyodide.mjs",
    "parity-reference": "node scripts/parity-reference.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/three": "0.187.0",
    "fflate": "0.8.3",
    "pyodide": "314.0.7",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "three": "0.187.0"
  }
}
